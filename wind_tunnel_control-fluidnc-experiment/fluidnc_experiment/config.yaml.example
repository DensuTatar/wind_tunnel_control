# TEMPLATE ONLY. Do not flash until all pins, travel, direction, drivers,
# switch polarity, and mechanical support are verified. Copy to config.yaml.
# Physical X = FluidNC X; physical Z = FluidNC Y.
name: Wind tunnel CoreXZ experiment
stepping:
  engine: RMT  # Assumes native ESP32 GPIO step/dir outputs
  idle_ms: 255 # No automatic idle disable; NOT a gravity safety device
  pulse_us: 5  # Verify driver timing
  dir_delay_us: 5
kinematics:
  corexy:
start:
  must_home: true
  check_limits: true
axes:
  x:
    steps_per_mm: 80.0
    max_rate_mm_per_min: 600.0
    acceleration_mm_per_sec2: 25.0 # Proposed conservative starting value
    max_travel_mm: 400.0 # replace with measured safe travel
    soft_limits: true
    homing:
      cycle: 1
      allow_single_axis: false
      positive_direction: false
      mpos_mm: 0.0
      seek_mm_per_min: 600.0
      feed_mm_per_min: 120.0
      settle_ms: 250
    motor0:
      limit_neg_pin: NO_PIN # TODO X_MIN, e.g. gpio.N:low:pu if supported
      limit_pos_pin: NO_PIN # TODO X_MAX
      hard_limits: true
      pulloff_mm: 3.0
      standard_stepper:
        step_pin: NO_PIN # TODO motor A STEP
        direction_pin: NO_PIN # TODO motor A DIR; verify sign
        disable_pin: NO_PIN # TODO if driver has controlled enable
  y:
    steps_per_mm: 80.0
    max_rate_mm_per_min: 600.0
    acceleration_mm_per_sec2: 25.0
    max_travel_mm: 400.0 # NOMINAL ONLY; replace with measured safe travel
    soft_limits: true
    homing:
      cycle: 2
      allow_single_axis: false
      positive_direction: false
      mpos_mm: 0.0
      seek_mm_per_min: 600.0
      feed_mm_per_min: 120.0
      settle_ms: 250
    motor0:
      limit_neg_pin: NO_PIN # TODO physical Z_MIN
      limit_pos_pin: NO_PIN # TODO physical Z_MAX
      hard_limits: true
      pulloff_mm: 3.0
      standard_stepper:
        step_pin: NO_PIN # TODO motor B STEP
        direction_pin: NO_PIN # TODO motor B DIR; verify sign
        disable_pin: NO_PIN # TODO if driver has controlled enable
